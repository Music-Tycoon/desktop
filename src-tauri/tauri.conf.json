{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Tycoon",
  "version": "0.1.0",
  "identifier": "app.musicopoly.desktop",
  "build": {
    "frontendDist": "../web-dist",
    "devUrl": "http://localhost:5181"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "BoardGame",
    "shortDescription": "El juego de mesa musical",
    "longDescription": "Music Tycoon: compra discográficas y estudios, sube al escenario y sé la estrella más rica. Juega en este ordenador, online con amigos o sin internet.",
    "copyright": "© 2026 Music Tycoon",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/es.lproj/InfoPlist.strings": "./macos/es.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings"
      },
      "dmg": {
        "background": "./installer/dmg-background.png",
        "windowSize": { "width": 640, "height": 400 },
        "appPosition": { "x": 170, "y": 205 },
        "applicationFolderPosition": { "x": 470, "y": 205 },
        "iconSize": 110
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "headerImage": "./installer/nsis-header.bmp",
        "sidebarImage": "./installer/nsis-sidebar.bmp",
        "installerIcon": "./icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Spanish", "PortugueseBR"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["musicopoly"]
      }
    }
  }
}
